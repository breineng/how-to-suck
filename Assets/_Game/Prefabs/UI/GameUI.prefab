  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "\u042F\u0437\u044B\u043A Steam \u0432\u044B\u0431\u0438\u0440\u0430\u0435\u0442\u0441\u044F
    \u0430\u0432\u0442\u043E\u043C\u0430\u0442\u0438\u0447\u0435\u0441\u043A\u0438.
    \u0411\u0435\u0437 Steam \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u0435\u0442\u0441\u044F
    \u044F\u0437\u044B\u043A \u0441\u0438\u0441\u0442\u0435\u043C\u044B. \u041D\u0430\u0436\u043C\u0438\u0442\u0435
    \xAB\u041F\u0440\u0438\u043C\u0435\u043D\u0438\u0442\u044C\xBB, \u0447\u0442\u043E\u0431\u044B
    \u0441\u043E\u0445\u0440\u0430\u043D\u0438\u0442\u044C \u0432\u044B\u0431\u043E\u0440."
  m_isRightToLeft: 0
